@

<<codigo_grafico_fases, eval=FALSE, echo=TRUE>>=

#------------------------------------------------------------
# Cálculo de los indicadores representados en el gráfico
# Mediana e intervalo intercuartílico (Q1-Q3)
# -----------------------------------------------------------

info_resumen_grafico <- info_fases_plot %>%
  group_by(fase) %>%
  summarise(
    q1 = quantile(edad_percibida, 
                  probs = 0.25,
                  na.rm = TRUE), 
    mediana = median(edad_percibida, 
                     na.rm = TRUE), 
    q3 = quantile(edad_percibida, 
                  probs = 0.75,
